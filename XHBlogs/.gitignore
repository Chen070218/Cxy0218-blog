# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Cloudflare Pages Functions 本地调试变量（含密钥，不进仓库）
.dev.vars

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 允许提交示例文件（真实密钥仍被忽略）
!.env.local.example
